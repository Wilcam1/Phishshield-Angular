{
  "name": "phishshield-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -n \"ML,API,APP\" -c \"magenta,blue,green\" \"npm run ml\" \"npm run server\" \"npm run client\"",
    "start:no-ml": "concurrently -n \"API,APP\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "ml": "node server/ml_service/run.js",
    "client": "ng serve --port 4200",
    "server": "node server/index.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server": "vitest run server/tests",
    "test:all": "ng test && vitest run server/tests",
    "lint": "ng lint"
  },
  "type": "module",
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "puppeteer": "^25.13.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.186.0",
    "angular-eslint": "22.5.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "supertest": "^7.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
